# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin account emails
ADMIN_EMAILS=

# SMS notifications (server-only, Hubtel). Deferred until credentials are configured.
SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SMS_BASE_URL=https://smsc.hubtel.com/v1/messages/send
SMS_SENDER_ID=EdenBites
SMS_BUSINESS_TO=233594528883 # Kitchen recipient in international digits without +
SMS_NOTIFICATIONS_ENABLED=false

# Email notifications (server-only, Gmail SMTP)
EMAIL_NOTIFICATIONS_ENABLED=false
GMAIL_USER=arthurfestus00@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=arthurfestus00@gmail.com
EMAIL_BUSINESS_TO=arthurfestus00@gmail.com

NOTIFICATION_RETRY_SECRET= # Shared secret for protected retry endpoint (optional)

# Canonical site URL used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 storefront controls (public)
# Set to false to pause ordering and show the optional note.
NEXT_PUBLIC_STORE_OPEN=true
NEXT_PUBLIC_STORE_NOTE=

# Optional customer-facing contact details. Leave blank to hide each item.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_SMS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
