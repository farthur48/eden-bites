# Public Supabase configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin account emails
ADMIN_EMAILS=

# Canonical site URL used for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 2 storefront controls (public)
# Set to false to pause ordering and show the optional note.
NEXT_PUBLIC_STORE_OPEN=true
NEXT_PUBLIC_STORE_NOTE=

# Optional customer-facing contact details. Leave blank to hide each item.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_INSTAGRAM=
